// The editor's NMI dispatch: every NMI runs the replay once, as its full tick
// (entry +3) when the sub-frame counter is 0, else as its band-only call (entry +6);
// the counter then counts to the ratio and wraps. `tick` is 1 for a full tick.
spec defmon_nmi;
layout { counter, ratio, tick: addr; }
cell counter: u8 @ L.counter;
cell ratio: u8 @ L.ratio ro;
cell tick: u8 @ L.tick scratch;

machine nmi {
  step {
    tick := u8(counter == 0);
    let after = counter + 1;
    if after == ratio {
      counter := 0;
    } else {
      counter := after;
    }
  }
}

schedule {
  nmi;
}
