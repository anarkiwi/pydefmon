// defMON sidTAB row interpreter: the bitmap-selected column values of one row,
// read through the pointer in zero page, applied to one voice's record (VOICE
// bytes per voice). Low bitmap bits 6, 7, 5..1 select WGh, WGl, AD, SR, TR, AF, PW, in that order; high
// bitmap bits 7..3 select PS, RE, FV, CP, ACID. TR is absolute with bit 7 set, else
// relative to the voice's note base; PW keeps its low nibble in the high register.
// RE with $00 clears the voice's routing bit, with bit 3 set keeps the old low
// nibble and sets the bit, else stores the byte. ACID with bit 7 clear resets the
// accumulator, else sets the step and, from bit 6, ADC or SBC for both bytes.
spec defmon_sidrow;
layout { voice: byte; ptr_lo, ptr_hi, wgh, wgl, ad, sr, note, note_base, af, pw_lo, pw_hi,
         ps, vbit, vmask, res, fv, cp, acc_lo, acc_hi, step_lo, step_hi, op_lo, op_hi: addr; }
const VOICE = 0x31;
const ADC_IMM = 0x69;
const SBC_IMM = 0xE9;
cell ptr: u16 @ (L.ptr_lo, L.ptr_hi);
cell res: u8 @ L.res;
cell fv: u8 @ L.fv;
cell cp: u8 @ L.cp;
cell acc_lo: u8 @ L.acc_lo operand;
cell acc_hi: u8 @ L.acc_hi operand;
cell step_lo: u8 @ L.step_lo operand;
cell step_hi: u8 @ L.step_hi operand;
cell op_lo: u8 @ L.op_lo operand;
cell op_hi: u8 @ L.op_hi operand;

machine row[x in 0..3] {
  cell wgh: u8 @ L.wgh + x * VOICE;
  cell wgl: u8 @ L.wgl + x * VOICE;
  cell ad: u8 @ L.ad + x * VOICE;
  cell sr: u8 @ L.sr + x * VOICE;
  cell note: u8 @ L.note + x * VOICE;
  cell note_base: u8 @ L.note_base + x * VOICE;
  cell af: u8 @ L.af + x * VOICE;
  cell pw_lo: u8 @ L.pw_lo + x * VOICE;
  cell pw_hi: u8 @ L.pw_hi + x * VOICE;
  cell ps: u8 @ L.ps + x * VOICE;
  cell vbit: u8 @ L.vbit + x * VOICE ro;
  cell vmask: u8 @ L.vmask + x * VOICE ro;
  step {
    stream r = ptr @ 0;
    let low = next r;
    if low & 0x40 != 0 { wgh := next r; }
    if low & 0x80 != 0 { wgl := next r; }
    if low & 0x20 != 0 { ad := next r; }
    if low & 0x10 != 0 { sr := next r; }
    if low & 0x08 != 0 {
      let t = next r;
      note := ite(neg(t), t & 0x7F, (t + note_base) & 0x7F);
    }
    if low & 0x04 != 0 { af := next r; }
    if low & 0x02 != 0 {
      let w = next r;
      pw_hi := w;
      pw_lo := w & 0xF0;
    }
    let high = next r;
    if high & 0x80 != 0 { ps := next r; }
    if high & 0x40 != 0 {
      let b = next r;
      if b == 0 {
        res := res & vmask;
      } elif b & 0x08 != 0 {
        res := (res & 0x0F) | b | vbit;
      } else {
        res := b;
      }
    }
    if high & 0x20 != 0 { fv := next r; }
    if high & 0x10 != 0 { cp := next r; }
    if high & 0x08 != 0 {
      let lo = next r;
      let hi = next r;
      if !neg(hi) {
        acc_lo := lo;
        acc_hi := hi;
        step_lo := 0;
        step_hi := 0;
      } elif hi & 0x40 != 0 {
        step_lo := lo;
        step_hi := hi & 0x3F;
        op_lo := SBC_IMM;
        op_hi := SBC_IMM;
      } else {
        step_lo := lo;
        step_hi := hi & 0x7F;
        op_lo := ADC_IMM;
        op_hi := ADC_IMM;
      }
    }
  }
}

schedule {
  row[L.voice];
}
