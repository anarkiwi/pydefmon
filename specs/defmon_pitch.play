// defMON pitch of one voice, every call: slide mode 0 adds the voice's detune byte
// to the note's pitch with no carry into the high byte; $01-$7F adds a constant
// detune, the pitch step of the semitone 24 below note + mode, with carry (the step
// is kept in the operands of the two instructions that add it); $80-$FF steps a
// 16-bit accumulator by a rate (bit 6: down) and adds the pitch to it with carry.
spec defmon_pitch;
layout { voice: byte; mode, acc_lo, acc_hi, detune, note, freq_lo, freq_hi, pitch_lo, pitch_hi,
         rate_lo, rate_hi, step_lo, step_hi: addr; }
const VOICE = 0x31;
cell step_lo: u8 @ L.step_lo operand;
cell step_hi: u8 @ L.step_hi operand;

machine voice[x in 0..3] {
  cell mode: u8 @ L.mode + x * VOICE;
  cell acc_lo: u8 @ L.acc_lo + x * VOICE;
  cell acc_hi: u8 @ L.acc_hi + x * VOICE;
  cell detune: u8 @ L.detune + x * VOICE ro;
  cell note: u8 @ L.note + x * VOICE;
  cell freq_lo: u8 @ L.freq_lo + x * VOICE operand;
  cell freq_hi: u8 @ L.freq_hi + x * VOICE operand;
  step {
    let plo = mem[L.pitch_lo + u16(note)];
    let phi = mem[L.pitch_hi + u16(note)];
    if mode == 0 {
      freq_lo := plo + detune;
      freq_hi := phi;
    } else {
      if !neg(mode) {
        let y = u16(mode + note);
        let lo = mem[L.pitch_lo - 24 + y];
        let lo_prev = mem[L.pitch_lo - 25 + y];
        let hi = mem[L.pitch_hi - 24 + y];
        let hi_prev = mem[L.pitch_hi - 25 + y];
        step_lo := lo - lo_prev;
        step_hi := hi - hi_prev - u8(lo < lo_prev);
        freq_lo := plo + step_lo;
        freq_hi := phi + step_hi + u8(carry(plo, step_lo));
      } else {
        let r = u16((mode << 1) & 0x7F);
        let up = !(mode & 0x40 != 0);
        if up {
          let c = carry(acc_lo, mem[L.rate_lo + r]);
          acc_lo += mem[L.rate_lo + r];
          acc_hi := acc_hi + mem[L.rate_hi + r] + u8(c);
        } else {
          let b = acc_lo < mem[L.rate_lo + r];
          acc_lo -= mem[L.rate_lo + r];
          acc_hi := acc_hi - mem[L.rate_hi + r] - u8(b);
        }
        freq_lo := plo + acc_lo;
        freq_hi := phi + acc_hi + u8(carry(plo, acc_lo));
      }
    }
  }
}

schedule {
  voice[L.voice];
}
