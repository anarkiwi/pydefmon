// defMON's play call. The band writes the SID from what the last call left in each voice, then the
// filter registers and the cutoff slide follow. The arranger moves on when a pattern ends and
// restarts the patterns and their step counters; each voice's pattern reader counts a step out and
// reads the next: a note, and the sidTAB rows to start. Six sidTAB tables (two per voice) apply a
// row of column writes and wait out its delay. The voices sound last: pitch with detune, a
// semitone step or a slide, then the pulse-width sweep.
spec defmon;

layout {
  sid, cp, pitch_lo, pitch_hi: addr;
  floor, init_extra, init_trigger, init_order_at, init_loop_at, init_loop_left, init_res, init_fv,
  init_falling, init_cut, init_cut_step: byte;
  uncounted, plain_tr, or_ctrl, shifts, fixed, reduced, cp_extra: flag;
  column1, column2, column3, patterns, rows, delays, rates, detune, vbit, vmask: list;
  init_freq, init_pw, init_wgh, init_wgl, init_ad, init_sr, init_note, init_note_base, init_mode,
  init_depth, init_slide, init_counter, init_ptr, init_pos, init_wait: list;
}

cell sid_cutoff: u8 @ L.sid + 0x16 out;
cell sid_res: u8 @ L.sid + 0x17 out;
cell sid_vol: u8 @ L.sid + 0x18 out;
// The CP column stores to the cutoff offset; a replay relocated without patching that store
// leaves it at an address outside the player.
cell stray: u8 @ L.cp;

// Song data: the arranger's three columns of pattern numbers, the patterns' addresses, the sidTAB
// rows' addresses and delays, and the slide rates. The note pitch table is read at the note and,
// for a semitone step, at 24 and 25 entries before the index y = mode + note.
state column1: u8[] ro = L.column1;
state column2: u8[] ro = L.column2;
state column3: u8[] ro = L.column3;
state patterns: u16[] ro = L.patterns;
state rows: u16[] ro = L.rows;
state delays: u8[] ro = L.delays;
state rates: u16[] ro = L.rates;
cell pitch: u16[256] @ (L.pitch_lo, L.pitch_hi) ro notes(word, -24);
cell below: u16[256] @ (L.pitch_lo - 25, L.pitch_hi - 25) ro notes(word, -49);
cell above: u16[256] @ (L.pitch_lo - 24, L.pitch_hi - 24) ro notes(word, -48);

// The pattern end that wakes the arranger (bit 7, the speed in the low nibble), its row, the loop
// row it counts and the passes left; the filter registers; the cutoff slide's position, step and
// direction, and the offset the CP column sets.
state trigger: u8 = L.init_trigger;
state order_at: u8 = L.init_order_at;
state loop_at: u8 = L.init_loop_at;
state loop_left: u8 = L.init_loop_left;
state res: u8 = L.init_res;
state fv: u8 = L.init_fv;
state cut: u16 = L.init_cut;
state cut_step: u16 = L.init_cut_step;
state falling: bool = L.init_falling != 0;
state extra: u8 = L.init_extra;

machine band[x in 0..3] {
  record chip @ L.sid stride 7 { out_freq: u16; out_pw: u12; out_ctrl: u8; out_ad: u8; out_sr: u8; }
  step {
    out_freq := voice[x].freq;
    out_pw := voice[x].pw;
    out_ad := voice[x].ad;
    out_sr := voice[x].sr;
    if L.or_ctrl {
      out_ctrl := voice[x].wgh | voice[x].wgl;
    } else {
      out_ctrl := voice[x].wgh ^ voice[x].wgl;
    }
  }
}

// The filter registers, and the cutoff slide: the 16-bit position moves by its step (one more
// down), and the register is its high byte plus the offset and the slide's carry, held to the floor
// and doubled in a build that shifts.
machine filter {
  step {
    sid_res := res;
    sid_vol := fv | 0x0F;
    let up = false;
    if falling {
      up := !borrow(cut, cut_step, true);
      cut := cut - cut_step - 1;
    } else {
      up := carry(cut, cut_step);
      cut += cut_step;
    }
    let bottom = L.floor;
    if neg(hi(cut)) {
      cut.hi := bottom;
    }
    let out = hi(cut) + extra + u8(up);
    if neg(out) || out < bottom {
      out := bottom;
    }
    if L.shifts {
      out := out << 1;
    }
    sid_cutoff := out;
  }
}

// The arranger runs when a pattern has ended: every reader restarts with the speed in the ending
// step, and takes its pattern from the next row. A row whose first column has bit 7 jumps to its
// second column; a nonzero third column counts how many times (a build that counts).
machine arranger {
  step {
    if !neg(trigger) {
      return;
    }
    let speed = trigger & 0x0F;
    trigger := speed;
    for v in 0..3 {
      reader[v].counter := speed;
    }
    let y = order_at;
    if neg(column1[y]) {
      if L.uncounted || column3[y] == 0 {
        y := column2[y];
      } elif loop_at != y {
        loop_at := y;
        loop_left := column3[y];
        y := column2[y];
      } else {
        loop_left -= 1;
        if loop_left != 0 {
          y := column2[y];
        } else {
          loop_at := 0;
          y += 1;
        }
      }
    }
    reader[0].ptr := patterns[column1[y]];
    reader[1].ptr := patterns[column2[y]];
    reader[2].ptr := patterns[column3[y]];
    order_at := y + 1;
  }
}

// A voice's pattern: steps of a flag byte (bit 7 ends the pattern, bits 6, 5, 4 say which of the
// two sidTAB rows and the note follow, the low nibble is the step's length), and a note starts
// its tables and clears the voice's slide and mode.
machine reader[x in 0..3] {
  state counter: u8 = L.init_counter[x];
  state ptr: u16 = L.init_ptr[x];

  proc skip(s: stream) {
    if L.fixed {
      s.pos += 1;
    }
  }

  step {
    if !neg(counter) {
      counter -= 1;
      return;
    }
    stream steps = ptr @ 0;
    let flag = next steps;
    if flag & 0x40 != 0 {
      table[x].pos := next steps;
      table[x].wait := 0;
    } else {
      skip(steps);
    }
    if flag & 0x20 != 0 {
      table[3 + x].pos := next steps;
      table[3 + x].wait := 0;
    } else {
      skip(steps);
    }
    if flag & 0x10 != 0 {
      let n = next steps;
      voice[x].note_base := n;
      voice[x].note := n;
      voice[x].slide := 0;
      voice[x].mode := 0;
    } else {
      skip(steps);
    }
    if neg(flag) {
      trigger := flag;
    } else {
      ptr += u16(steps.pos);
      counter := flag & 0x0F;
    }
  }
}

// A sidTAB table, run for its voice: a row of column writes, then its delay in calls ($80.. stops
// the table). A row whose address high byte is zero is a jump to the row numbered by its low byte.
machine table[k in 0..6] {
  state pos: u8 = L.init_pos[k];
  state wait: u8 = L.init_wait[k];

  step {
    if neg(wait) {
      return;
    }
    if wait != 0 {
      wait -= 1;
      return;
    }
    let n = pos;
    if rows[n] < 0x100 {
      n := lo(rows[n]);
    }
    wait := delays[n];
    pos := n + 1;
    columns(rows[n]);
  }

  // A row: a bitmap of the columns the first byte selects, then one for the second byte's.
  proc columns(address: u16) {
    stream bytes = address @ 0 grammar "pydefmon._layout:STREAMS:row";
    let low = next bytes;
    if low != 0 {
      if low & 0x40 != 0 {
        voice[k % 3].wgh := next bytes;
      }
      if low & 0x80 != 0 {
        voice[k % 3].wgl := next bytes;
      }
      if low & 0x20 != 0 {
        voice[k % 3].ad := next bytes;
      }
      if low & 0x10 != 0 {
        voice[k % 3].sr := next bytes;
      }
      if low & 0x08 != 0 {
        let tr = next bytes;
        if L.plain_tr {
          voice[k % 3].note := tr + voice[k % 3].note_base;
        } else {
          voice[k % 3].note := ite(neg(tr), tr & 0x7F, (tr + voice[k % 3].note_base) & 0x7F);
        }
      }
      if low & 0x04 != 0 {
        voice[k % 3].mode := next bytes;
      }
      if low & 0x02 != 0 {
        let w = next bytes;
        voice[k % 3].pw := word(w & 0xF0, w);
      }
    }
    let high = next bytes;
    if high == 0 {
      return;
    }
    if high & 0x80 != 0 {
      voice[k % 3].depth := next bytes;
    }
    if high & 0x40 != 0 {
      let b = next bytes;
      if b == 0 {
        res := res & L.vmask[k % 3];
      } elif b & 0x08 != 0 {
        res := (res & 0x0F) | b | L.vbit[k % 3];
      } else {
        res := b;
      }
    }
    if high & 0x20 != 0 {
      fv := next bytes;
    }
    if high & 0x10 != 0 {
      if L.cp_extra {
        extra := next bytes;
      } else {
        stray := next bytes;
      }
    }
    if high & 0x08 != 0 {
      let lo = next bytes;
      let hi = next bytes;
      if !neg(hi) {
        cut := word(lo, hi);
        cut_step := 0;
      } elif hi & 0x40 != 0 {
        cut_step := word(lo, hi & 0x3F);
        falling := true;
      } else {
        cut_step := word(lo, hi & 0x7F);
        falling := false;
      }
    }
  }
}

// A voice sounds: its pitch from the note and the slide mode (0 adds the voice's detune to the
// low byte alone; $01..$7F adds the pitch step of the semitone 24 below note + mode; $80..$FF
// moves a 16-bit slide by a rate, bit 6 down, and adds it), then the pulse-width sweep (bit 7 of
// the depth up, else down), which takes the carry the pitch left.
machine voice[x in 0..3] {
  state freq: u16 = L.init_freq[x];
  state pw: u16 = L.init_pw[x];
  state wgh: u8 = L.init_wgh[x];
  state wgl: u8 = L.init_wgl[x];
  state ad: u8 = L.init_ad[x];
  state sr: u8 = L.init_sr[x];
  state note: u8 = L.init_note[x];
  state note_base: u8 = L.init_note_base[x];
  state mode: u8 = L.init_mode[x];
  state depth: u8 = L.init_depth[x];
  state slide: u16 = L.init_slide[x];

  step {
    let base = pitch[note];
    let cy = false;
    if mode == 0 {
      freq := base;
      freq.lo := lo(base) + L.detune[x];
      cy := carry(lo(base), L.detune[x]);
    } elif !neg(mode) {
      let y = mode + note;
      let delta = above[y] - below[y];
      freq := base + delta;
      cy := carry(base, delta);
    } else {
      let r = rates[(mode << 1) & 0x7F];
      if mode & 0x40 == 0 {
        slide += r;
      } else {
        slide -= r;
      }
      freq := base + slide;
      cy := carry(base, slide);
    }
    if depth == 0 {
      return;
    }
    if neg(depth) {
      let up = depth & 0x7F;
      if carry(lo(pw), up) && hi(pw) == 0x0F {
        pw.lo := 0xF8;
        depth ^= 0x80;
      } else {
        pw += u16(up);
      }
    } else {
      if borrow(lo(pw), depth, !cy) && hi(pw) == 0 {
        pw.lo := 1;
        depth ^= 0x80;
      } else {
        pw := pw - u16(depth) - u16(!cy);
      }
    }
  }
}

schedule {
  for v in 0..3 {
    band[v];
  }
  filter;
  if !L.reduced {
    arranger;
    for v in 0..3 {
      reader[v];
    }
  }
  for k in 0..6 {
    table[k];
  }
  voice[2];
  voice[1];
  voice[0];
}
