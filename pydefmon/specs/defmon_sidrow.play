// defMON sidTAB row interpreter: the bitmap-selected column values of one row, read
// through the pointer whose low byte arrives in the accumulator and whose high byte is
// in zero page, applied to the voice record X selects (VOICE bytes per voice). Low
// bitmap bits 6, 7, 5..1 select WGh, WGl, AD, SR, TR, AF, PW, in that order; high
// bitmap bits 7..3 select PS, RE, FV, CP, ACID. TR is absolute with bit 7 set, else
// relative to the voice's note base; PW keeps its low nibble in the high register.
// RE with $00 clears the voice's routing bit, with bit 3 set keeps the old low nibble
// and sets the bit, else stores the byte. ACID with bit 7 clear resets the
// accumulator, else sets the step and, from bit 6, ADC or SBC for both bytes. The
// shifted bitmap is left in a zero-page scratch byte.
spec defmon_sidrow;
layout { ptr_lo, ptr_hi, wgh, wgl, ad, sr, note, note_base, af, pw_lo, pw_hi,
         ps, vbit, vmask, res, fv, cp, acc_lo, acc_hi, step_lo, step_hi, op_lo, op_hi,
         scratch: addr; }
const ADC_IMM = 0x69;
const SBC_IMM = 0xE9;
cell ptr: u16 @ (L.ptr_lo, L.ptr_hi);
cell scratch: u8 @ L.scratch scratch;
cell res: u8 @ L.res;
cell fv: u8 @ L.fv;
cell cp: u8 @ L.cp;
cell acc_lo: u8 @ L.acc_lo operand;
cell acc_hi: u8 @ L.acc_hi operand;
cell step_lo: u8 @ L.step_lo operand;
cell step_hi: u8 @ L.step_hi operand;
cell op_lo: u8 @ L.op_lo operand;
cell op_hi: u8 @ L.op_hi operand;

machine row {
  step {
    let v = u16(cpu.x);
    mem[L.ptr_lo] := cpu.a;
    stream r = ptr @ 0;
    let low = next r;
    if low != 0 {
      scratch := low << 1;
      if low & 0x40 != 0 { mem[L.wgh + v] := next r; }
      if low & 0x80 != 0 { mem[L.wgl + v] := next r; }
      if low & 0x20 != 0 { mem[L.ad + v] := next r; }
      if low & 0x10 != 0 { mem[L.sr + v] := next r; }
      if low & 0x08 != 0 {
        let t = next r;
        mem[L.note + v] := ite(neg(t), t & 0x7F, (t + mem[L.note_base + v]) & 0x7F);
      }
      if low & 0x04 != 0 { mem[L.af + v] := next r; }
      if low & 0x02 != 0 {
        let w = next r;
        mem[L.pw_hi + v] := w;
        mem[L.pw_lo + v] := w & 0xF0;
      }
    }
    let high = next r;
    if high == 0 {
      return;
    }
    scratch := high << 1;
    if high & 0x80 != 0 { mem[L.ps + v] := next r; }
    if high & 0x40 != 0 {
      let b = next r;
      if b == 0 {
        res := res & mem[L.vmask + v];
      } elif b & 0x08 != 0 {
        res := (res & 0x0F) | b | mem[L.vbit + v];
      } else {
        res := b;
      }
    }
    if high & 0x20 != 0 { fv := next r; }
    if high & 0x10 != 0 { cp := next r; }
    if high & 0x08 != 0 {
      let lo = next r;
      let hi = next r;
      if !neg(hi) {
        acc_lo := lo;
        acc_hi := hi;
        step_lo := 0;
        step_hi := 0;
      } elif hi & 0x40 != 0 {
        step_lo := lo;
        step_hi := hi & 0x3F;
        op_lo := SBC_IMM;
        op_hi := SBC_IMM;
      } else {
        step_lo := lo;
        step_hi := hi & 0x7F;
        op_lo := ADC_IMM;
        op_hi := ADC_IMM;
      }
    }
  }
}

schedule {
  row;
}
