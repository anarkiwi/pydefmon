// defMON ACID cutoff slide: a 16-bit accumulator stepped by ADC or SBC, the
// instruction chosen by a self-modified opcode byte in the code (an operand cell);
// a high byte with bit 7 set, or an output below the floor, gives the floor.
spec defmon_acid;
layout { acc_lo, acc_hi, step_lo, step_hi, opcode, extra, floor, sid: addr; }
const SBC_IMM = 0xE9;
cell acc_lo: u8 @ L.acc_lo;
cell acc_hi: u8 @ L.acc_hi;
cell step_lo: u8 @ L.step_lo;
cell step_hi: u8 @ L.step_hi;
cell opcode: u8 @ L.opcode operand;
cell extra: u8 @ L.extra;
cell floor: u8 @ L.floor operand;
cell sid: u8[32] @ L.sid out;

machine acid {
  step {
    let c = false;
    if opcode == SBC_IMM {
      c := !borrow(acc_lo, step_lo, true);
      acc_lo := acc_lo - step_lo - 1;
      let cin = c;
      c := !borrow(acc_hi, step_hi, !cin);
      acc_hi := acc_hi - step_hi - u8(!cin);
    } else {
      c := carry(acc_lo, step_lo);
      acc_lo += step_lo;
      let cin = c;
      c := carry(acc_hi, step_hi, cin);
      acc_hi := acc_hi + step_hi + u8(cin);
    }
    if neg(acc_hi) {
      acc_hi := floor;
    }
    let out = acc_hi + extra + u8(c);
    if neg(out) || out < floor {
      out := floor;
    }
    sid[0x16] := out;
  }
}

schedule {
  acid;
}
