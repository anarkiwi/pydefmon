// defMON arranger walker: one shared row cursor over the three voice
// arrangers; a stepped-onto row with V1 bit 7 jumps to V2, V3 times (0: always),
// all jump rows sharing one loop counter; the landing row is not re-checked.
spec defmon_arranger;
layout { row, loop, v1, v2, v3, pattern: addr; }
cell v1: u8[256] @ L.v1 ro;
cell v2: u8[256] @ L.v2 ro;
cell v3: u8[256] @ L.v3 ro;
cell pattern: u8[3] @ L.pattern;

machine arranger {
  cell row: u8 @ L.row;
  cell loop: u8 @ L.loop;
  step {
    row += 1;
    if v1[row] & 0x80 != 0 {
      if v3[row] == 0 {
        row := v2[row];
      } elif loop == 0 {
        loop := v3[row];
        row := v2[row];
      } else {
        loop -= 1;
        if loop == 0 {
          row += 1;
        } else {
          row := v2[row];
        }
      }
    }
    pattern[0] := v1[row];
    pattern[1] := v2[row];
    pattern[2] := v3[row];
  }
}

schedule {
  arranger;
}
