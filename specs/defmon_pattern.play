// defMON pattern steps on the main tick: a flag byte, then one payload byte per
// set gate (A $40, B $20, N $10); a step lasts d+2 ticks; ALT ($80) ends the
// arranger step of all voices, which the arranger acts on at the next tick.
spec defmon_pattern;
layout { counter, ptr_lo, ptr_hi, row_a, row_b, cnt_a, cnt_b, note, base, pending, dur, steps: addr; }
cell counter: u8[3] @ L.counter;
cell pending: u8 @ L.pending latched;
cell dur: u8 @ L.dur;

machine arranger {
  cell steps: u8 @ L.steps;
  step {
    if pending != 0 {
      pending := 0;
      steps += 1;
      for v in 0..3 {
        counter[v] := dur + 1;
      }
    }
  }
}

machine voice[x in 0..3] {
  cell ptr: u16 @ (L.ptr_lo + x, L.ptr_hi + x);
  cell row_a: u8 @ L.row_a + x;
  cell row_b: u8 @ L.row_b + x;
  cell cnt_a: u8 @ L.cnt_a + x;
  cell cnt_b: u8 @ L.cnt_b + x;
  cell note: u8 @ L.note + x;
  cell base: u8 @ L.base + x;
  step {
    counter[x] -= 1;
    if !neg(counter[x]) {
      return;
    }
    stream p = ptr @ 0;
    let flag = next p;
    if flag & 0x40 != 0 {
      row_a := next p;
      cnt_a := 0;
    }
    if flag & 0x20 != 0 {
      row_b := next p;
      cnt_b := 0;
    }
    if flag & 0x10 != 0 {
      let n = next p;
      note := n;
      base := n;
    }
    counter[x] := (flag & 0x0F) + 1;
    ptr += u16(p.pos);
    if flag & 0x80 != 0 {
      dur := flag & 0x0F;
      mem[L.pending] := 1;
    }
  }
}

schedule {
  arranger;
  voice[0];
  voice[1];
  voice[2];
}
